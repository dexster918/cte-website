# CTE 2018 — environment variables
# Copy this file to ".env" for local testing, or paste the values
# into the hosting dashboard (e.g. Render → Environment).

# MongoDB connection string (from MongoDB Atlas → Connect → Drivers)
# When this is set, the site stores its content in MongoDB (persistent).
# When it is empty, the site falls back to the local content.json file.
MONGODB_URI=

# Password used to save changes from admin.html
ADMIN_PASSWORD=cte2026
